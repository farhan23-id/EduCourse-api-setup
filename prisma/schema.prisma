generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  ADMIN
  TUTOR
  STUDENT
}

model User {
  id        Int      @id @default(autoincrement())
  email     String   @unique
  name      String
  password  String
  role      Role     @default(STUDENT)
  courses   Course[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Course {
  id          Int      @id @default(autoincrement())
  title       String
  description String?
  price       Int      @default(0)
  tutorId     Int
  tutor       User     @relation(fields: [tutorId], references: [id])
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}